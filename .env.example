# Copy to .env only if you need to change something; every value below is the default.
# The services read these from the environment (no .env loader is required):
#   Windows (cmd):  set PORT=4000 && npm run start:api
#   macOS/Linux:    PORT=4000 npm run start:api

# API service
PORT=3000                      # HTTP + WebSocket port (web client, Android app)
API_DB=api-service/taskflow.db # SQLite file owned by the API service
IDENTITY_ADDR=127.0.0.1:50051  # where the API finds the identity service
IDENTITY_DEADLINE_MS=1500      # gRPC deadline for every identity call

# Identity service
IDENTITY_PORT=50051                  # gRPC port
IDENTITY_DB=identity-service/identity.db  # SQLite file owned by the identity service
SESSION_HOURS=12                     # how long a sign-in token lasts
IDENTITY_DELAY_MS=0                  # set e.g. 3000 to demonstrate the API's deadline
